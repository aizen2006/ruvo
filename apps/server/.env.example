# Copy to .env (Bun loads it automatically).

# --- Server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Storage (see docker-compose.yml) ---
DATABASE_URL=postgres://ruvo:ruvo@localhost:5432/ruvo
QDRANT_URL=http://localhost:6333

# --- OpenAI ---
OPENAI_API_KEY=
MODEL_PLANNER=gpt-6-sol
MODEL_WORKER=gpt-6-luna
EMBED_MODEL=text-embedding-3-small
LLM_CACHE_MODE=on            # off | on | cache_only

# --- Decision layer (System One wire format: Jev hosted, or local Laya) ---
DECIDER_PROVIDER=jev         # jev | laya | off
DECIDER_BASE_URL=https://api.typesafe.ai   # http://localhost:8000 for Laya
DECIDER_MODEL=jev-1.13.0
TYPESAFE_API_KEY=
DECIDER_MODE=active         # off | shadow | active

# --- Execution ---
WORKER_INLINE=false          # true = run the worker loop inside the API process
BROWSER_MODE=native          # native | sidecar | spawn
FETCH_CACHE_MODE=ttl         # off | ttl | prefer_cache | cache_only
USER_AGENT=RUVO/0.1 (+https://github.com/aizen2006/ruvo)

# --- Per-run caps ---
MAX_PAGES=150
MAX_BROWSER_PAGES=10
MAX_LLM_CALLS=60
MAX_RUN_MS=240000

# Copy to .env (Bun loads it automatically).

# --- Server ---
PORT=3000
# HOST=0.0.0.0               # reach the API from other machines; unset = this machine only
NODE_ENV=development
LOG_LEVEL=info

# --- Storage (see docker-compose.yml) ---
DATABASE_URL=postgres://ruvo:ruvo@localhost:5432/ruvo

# --- OpenAI ---
OPENAI_API_KEY=
MODEL_PLANNER=gpt-6-sol
MODEL_WORKER=gpt-6-luna
LLM_CACHE_MODE=on            # off | on | cache_only

# --- Decision layer (System One wire format: Jev hosted, or local Laya) ---
DECIDER_PROVIDER=jev         # jev | laya | off
DECIDER_BASE_URL=https://api.typesafe.ai   # http://localhost:8000 for Laya
DECIDER_MODEL=jev-1.13.0
TYPESAFE_API_KEY=
DECIDER_MODE=active         # off | shadow | active

# --- Execution ---
WORKER_INLINE=false          # true = run the worker loop inside the API process
FETCH_CACHE_MODE=ttl         # off | ttl | prefer_cache | cache_only
USER_AGENT=RUVO/0.1 (+https://github.com/aizen2006/ruvo)
SCRAPLING_URL=http://127.0.0.1:8001   # RUVO's Scrapling fetch service; `bun run dev` starts it; blank = plain requests only
# SCRAPLING_PYTHON=python            # the Python that has Scrapling; unset = python (Windows) or python3

# --- Web search for finding sources: SearXNG on this machine (docker compose runs it), blank = off ---
SEARXNG_URL=http://127.0.0.1:8888

# --- Firecrawl (optional): the backup when SearXNG fails or finds nothing, and the last way to read a page Scrapling could not ---
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_USD_PER_CREDIT=0.0032
MAX_SEARCHES=20              # ceiling on web searches per run

# --- Per-run ceilings (each mode sets its own budgets; none can go above these) ---
MAX_PAGES=300
MAX_BROWSER_PAGES=20
MAX_LLM_CALLS=150
MAX_RUN_MS=480000
# DAILY_BUDGET_USD=5          # optional: no new runs once the last 24 hours of AI + search spend reach this

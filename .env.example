# Configuration for docker-compose.prod.yml. Copy to .env (git-ignored) and fill in.
# Any other server setting from apps/server/.env.example can be added here too.

# Required. Use a URL-safe value, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# Required: understanding requests, planning, recipe discovery and the judge use it.
OPENAI_API_KEY=

# The API's URL as the browser reaches it; baked into the dashboard image at build time.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional providers.
TYPESAFE_API_KEY=
# The backup web search, and the last way to read a page Scrapling could not.
FIRECRAWL_API_KEY=

# Optional: SearXNG's secret key. Unset, it gets a new random one at each start, which is fine.
SEARXNG_SECRET=
